#!/usr/bin/env bash
# PASS/FAIL một dòng; exit ≠ 0 khi lỗi. Chạy ~10s, không nặng máy.
set -u
HERE=$(cd "$(dirname "$0")" && pwd)
T=$(mktemp -d); trap 'rm -rf "$T"' EXIT
export JOBQ_ADAPT=0 JOBQ_MAX_PRESSURE=99 JOBQ_DIR="$T/q" JOBQ_SLOTS=2 JOBQ_MAX_LOAD=999 JOBQ_MIN_FREE_MB=0
fail() { echo "FAIL: $1"; exit 1; }

bash -n "$HERE/jobq" || fail "cú pháp"

# 1) 5 job mỗi job 1s: đồng thời không quá 2, cả 5 đều xong
mkdir -p "$T/run" "$T/done"
for n in 1 2 3 4 5; do
  "$HERE/jobq" run -- bash -c "touch $T/run/$n; echo \$(ls $T/run | wc -l) >> $T/peak; sleep 1; rm $T/run/$n; touch $T/done/$n" &
done
wait
[ "$(ls "$T/done" | wc -l)" -eq 5 ] || fail "không đủ 5 job xong"
[ "$(sort -n "$T/peak" | tail -1)" -le 2 ] || fail "vượt 2 job đồng thời"

# 2) exit code truyền ra
"$HERE/jobq" run -- bash -c 'exit 7'; [ $? -eq 7 ] || fail "exit code"

# 3) timeout giết cả cây lệnh
"$HERE/jobq" run -t 1 -- bash -c 'sleep 30 & wait' 2>/dev/null; [ $? -eq 124 ] || fail "timeout rc"
sleep 1; pgrep -f 'sleep 30( |&|$)' >/dev/null && fail "sleep 30 còn sống sau timeout"

# 4) lồng nhau không kẹt
"$HERE/jobq" run -- "$HERE/jobq" run -- true || fail "lồng nhau"

# 5) slot của tiến trình chết bị dọn
ln -s 99999999 "$T/q/slots/1"; ln -s 99999999 "$T/q/slots/2"
"$HERE/jobq" run -w 10 -- true || fail "slot chết không được dọn"

# 6) lint-script: template đạt, script xấu bị chặn
"$HERE/lint-script" "$HERE/template.sh" >/dev/null || fail "template không qua lint"
printf '#!/bin/bash\npnpm test &\n' > "$T/bad.sh"
"$HERE/lint-script" "$T/bad.sh" >/dev/null && fail "lint để lọt script xấu"

# 7) stepper: dừng ở bước lỗi, chạy lại thì bỏ qua bước đã PASS
mkdir -p "$T/st"; printf 'touch %s/s1\n' "$T" > "$T/st/01-a.sh"
printf '[ -e %s/ok ]\n' "$T" > "$T/st/02-b.sh"; printf 'touch %s/s3\n' "$T" > "$T/st/03-c.sh"
"$HERE/stepper" "$T/st" >/dev/null && fail "stepper không dừng ở bước lỗi"
[ -e "$T/s3" ] && fail "stepper chạy tiếp sau bước lỗi"
rm "$T/s1"; touch "$T/ok"
"$HERE/stepper" "$T/st" >/dev/null || fail "stepper không tiếp tục sau khi sửa"
[ -e "$T/s1" ] && fail "stepper chạy lại bước đã PASS"
[ -e "$T/s3" ] || fail "stepper không chạy bước 03"

# 8) lịch sử đo được ghi lại, stats đọc được
"$HERE/jobq" stats | grep -q 'lần' || fail "stats trống sau khi đã chạy job"

# 9) trần cứng: ngân sách jobs=3 vẫn bị kẹp xuống max jobs=1
(
  unset JOBQ_SLOTS; export JOBQ_DIR="$T/q2"; rm -rf "$T/peak2" "$T/run2"; mkdir -p "$T/run2"
  "$HERE/jobq" max jobs=1 >/dev/null; "$HERE/jobq" budget jobs=3 >/dev/null
  for n in 1 2 3; do
    "$HERE/jobq" run -- bash -c "touch $T/run2/$n; echo \$(ls $T/run2 | wc -l) >> $T/peak2; sleep 1; rm $T/run2/$n" &
  done
  wait
  [ "$(sort -n "$T/peak2" | tail -1)" -le 1 ]
) || fail "ngân sách vượt trần max"

# 10) --cost lớn: 2 job cpu=3 không chạy cùng lúc dưới ngân sách cpu=4
(
  unset JOBQ_SLOTS; export JOBQ_DIR="$T/q3"; rm -rf "$T/peak3" "$T/run3"; mkdir -p "$T/run3"
  for n in 1 2; do
    "$HERE/jobq" run --cost cpu=3,mem=100 -- bash -c "touch $T/run3/$n; echo \$(ls $T/run3 | wc -l) >> $T/peak3; sleep 1; rm $T/run3/$n" &
  done
  wait
  [ "$(sort -n "$T/peak3" | tail -1)" -le 1 ]
) || fail "điểm nặng không được tính"

# 11) script theo khuôn tự xếp hàng dù gọi thẳng
sed 's|^echo "PASS: <tên>.*|echo "${JOBQ_ACTIVE:-no}" > '"$T"'/active; echo "PASS: t"|' "$HERE/template.sh" > "$T/self.sh"; chmod +x "$T/self.sh"
JOBQ_BIN="$HERE/jobq" "$T/self.sh" >/dev/null || fail "script mẫu chạy lỗi"
[ "$(cat "$T/active")" = 1 ] || fail "script mẫu không tự xếp hàng"

# 12) áp lực RAM chặn lệnh thứ hai (ngưỡng 1 = luôn coi là đang căng)
( export JOBQ_DIR="$T/q4" JOBQ_MAX_PRESSURE=1
  "$HERE/jobq" run -- sleep 4 & sleep 1
  "$HERE/jobq" run -w 2 -- true 2>/dev/null; rc=$?; wait
  [ "$rc" -eq 75 ] ) || fail "áp lực RAM không chặn lệnh thứ hai"

# 13) chạy lách: lệnh nhẹ vào trước lệnh nặng đang chờ
( unset JOBQ_SLOTS; export JOBQ_DIR="$T/q5" JOBQ_SLOTS=3; : > "$T/order"
  "$HERE/jobq" run --cost cpu=3,mem=100 -- bash -c "echo A >> $T/order; sleep 5" & sleep 1.3
  "$HERE/jobq" run --cost cpu=3,mem=100 -- bash -c "echo B >> $T/order" & sleep 1.3
  "$HERE/jobq" run --cost cpu=0.5,mem=100 -- bash -c "echo C >> $T/order" & wait
  [ "$(tr -d '\n' < "$T/order")" = "ACB" ] ) || fail "lệnh nhẹ không chạy lách (thứ tự: $(tr -d '\n' < "$T/order"))"

# 14) tự co giãn: máy "quá tải" thì scale tụt xuống 25% nhưng vẫn có một lệnh chạy
( export JOBQ_DIR="$T/q6" JOBQ_ADAPT=1 JOBQ_ADAPT_SEC=1 JOBQ_MAX_LOAD=0
  "$HERE/jobq" run -- sleep 10 & sleep 1
  "$HERE/jobq" run -w 7 -- true 2>/dev/null; rc=$?; kill %1 2>/dev/null; wait 2>/dev/null
  [ "$rc" -eq 75 ] && [ "$(cut -d' ' -f1 "$T/q6/scale")" -eq 25 ] ) || fail "tự co giãn không hạ scale"

# 15) trang web tĩnh: snapshot.js hợp lệ, có lệnh đang chạy khi job chạy, rỗng khi xong; script trong trang không lỗi cú pháp
( export JOBQ_DIR="$T/q7"; "$HERE/jobq" web --no-open >/dev/null
  "$HERE/jobq" run -- sleep 4 & sleep 2.5
  sed 's/^window.JOBQ = //; s/;$//' "$JOBQ_DIR/web/snapshot.js" | jq -e '(.running|length)==1 and (.running[0].cmd|test("sleep 4"))' >/dev/null || exit 1
  wait; sleep 0.5
  sed 's/^window.JOBQ = //; s/;$//' "$JOBQ_DIR/web/snapshot.js" | jq -e '(.running|length)==0' >/dev/null ) || fail "snapshot.js không phản ánh lệnh đang chạy"
awk '/<script>/{f=1;next} /<\/script>/{f=0} f' "$HERE/dashboard.html" > "$T/dash.js"
node --check "$T/dash.js" || fail "script trong dashboard.html lỗi cú pháp"

# 16) hook jobq-guard: chặn đúng lệnh nặng, cho qua lệnh thường
g() { printf '{"tool_input":{"command":%s}}' "$(jq -Rn --arg c "$2" '$c')" | "$HERE/jobq-guard" 2>/dev/null; r=$?; e=0; [ "$1" = block ] && e=2; [ "$r" -eq "$e" ] || fail "jobq-guard sai ($1): $2"; }
while IFS='|' read -r exp c; do g "$exp" "$c"; done <<'CASES'
block|pnpm test
block|pnpm --filter api check-types
block|cd x && turbo run build
block|time pnpm lint
block|CI=1 pnpm test:unit
block|bun test
block|npx eslint src
block|pnpm exec prettier --check .
block|bash -c "pnpm test"
block|sh -c 'turbo run build'
block|docker compose build api
block|cargo test
block|pytest -q
block|bash scripts/check-x.sh
block|node scripts/test-foo.mjs
block|pnpm sdk:generate
block|pnpm -r exec tsc --noEmit
block|pnpm --filter api exec vitest run
block|npm exec -- tsc
block|npm run-script build
block|yarn workspaces foreach -A run build
block|make build
block|just test
block|python3 -m pytest
block|swift build
block|pod install
block|magick input.png -resize 50% out.png
block|sips -Z 512 a.png
block|lighthouse http://localhost:3003
block|k6 run load.js
block|pnpm verify
block|dotnet test
block|mvn test
block|bundle exec rspec
block|flutter build apk
block|deno test
block|ng build
block|echo ok; pnpm test
block|echo "x" && vitest run
pass|jobq run -- pnpm test
pass|pnpm install
pass|npm ci
pass|pnpm dev
pass|wrangler dev
pass|git status
pass|git commit -m "pnpm test fix"
pass|git commit -m "a|make|b; vitest run"
pass|echo "pnpm test"
pass|grep -E 'foo|build|test' src
pass|jq '.a | test("x")' f.json
pass|sed -i 's/a|just|b/c/' f
pass|echo tsc
pass|just do it
pass|pnpm db:generate
pass|tar -czf out.tgz big/
pass|rsync -a a/ b/
pass|grep -rn "check-types" .
pass|ls scripts/check-x.sh
CASES

# 17) ngưỡng tải đặt được bằng config, không cần biến môi trường
( unset JOBQ_MAX_LOAD; export JOBQ_DIR="$T/q8"; "$HERE/jobq" max load=10 >/dev/null; "$HERE/jobq" status | head -1 | grep -q 'tải=\|load=[0-9.]*/10 ' ) || fail "max load=10 không có hiệu lực"

[ -z "$(find "$T/q/slots" "$T/q/queue" -mindepth 1 2>/dev/null)" ] || fail "còn rác slot/queue"
echo "PASS: jobq (hàng đợi, điểm nặng, trần max, áp lực RAM, chạy lách, co giãn, trang web) + lint-script + stepper"
