#!/usr/bin/env bash
# PASS/FAIL một dòng; exit ≠ 0 khi lỗi. Chạy ~10s, không nặng máy.
set -u
HERE=$(cd "$(dirname "$0")" && pwd)
T=$(mktemp -d); trap 'rm -rf "$T"' EXIT
export JOBQ_DIR="$T/q" JOBQ_SLOTS=2 JOBQ_MAX_LOAD=999 JOBQ_MIN_FREE_MB=0
fail() { echo "FAIL: $1"; exit 1; }

bash -n "$HERE/jobq" || fail "cú pháp"

# 1) 5 job mỗi job 1s: đồng thời không quá 2, cả 5 đều xong
mkdir -p "$T/run" "$T/done"
for n in 1 2 3 4 5; do
  "$HERE/jobq" run -- bash -c "touch $T/run/$n; echo \$(ls $T/run | wc -l) >> $T/peak; sleep 1; rm $T/run/$n; touch $T/done/$n" &
done
wait
[ "$(ls "$T/done" | wc -l)" -eq 5 ] || fail "không đủ 5 job xong"
[ "$(sort -n "$T/peak" | tail -1)" -le 2 ] || fail "vượt 2 job đồng thời"

# 2) exit code truyền ra
"$HERE/jobq" run -- bash -c 'exit 7'; [ $? -eq 7 ] || fail "exit code"

# 3) timeout giết cả cây lệnh
"$HERE/jobq" run -t 1 -- bash -c 'sleep 30 & wait' 2>/dev/null; [ $? -eq 124 ] || fail "timeout rc"
sleep 1; pgrep -f 'sleep 30' >/dev/null && fail "sleep 30 còn sống sau timeout"

# 4) lồng nhau không kẹt
"$HERE/jobq" run -- "$HERE/jobq" run -- true || fail "lồng nhau"

# 5) slot của tiến trình chết bị dọn
ln -s 99999999 "$T/q/slots/1"; ln -s 99999999 "$T/q/slots/2"
"$HERE/jobq" run -w 10 -- true || fail "slot chết không được dọn"

# 6) lint-script: template đạt, script xấu bị chặn
"$HERE/lint-script" "$HERE/template.sh" >/dev/null || fail "template không qua lint"
printf '#!/bin/bash\npnpm test &\n' > "$T/bad.sh"
"$HERE/lint-script" "$T/bad.sh" >/dev/null && fail "lint để lọt script xấu"

# 7) stepper: dừng ở bước lỗi, chạy lại thì bỏ qua bước đã PASS
mkdir -p "$T/st"; printf 'touch %s/s1\n' "$T" > "$T/st/01-a.sh"
printf '[ -e %s/ok ]\n' "$T" > "$T/st/02-b.sh"; printf 'touch %s/s3\n' "$T" > "$T/st/03-c.sh"
"$HERE/stepper" "$T/st" >/dev/null && fail "stepper không dừng ở bước lỗi"
[ -e "$T/s3" ] && fail "stepper chạy tiếp sau bước lỗi"
rm "$T/s1"; touch "$T/ok"
"$HERE/stepper" "$T/st" >/dev/null || fail "stepper không tiếp tục sau khi sửa"
[ -e "$T/s1" ] && fail "stepper chạy lại bước đã PASS"
[ -e "$T/s3" ] || fail "stepper không chạy bước 03"

# 8) lịch sử đo được ghi lại, stats đọc được
"$HERE/jobq" stats | grep -q 'lần' || fail "stats trống sau khi đã chạy job"

# 9) trần cứng: ngân sách jobs=3 vẫn bị kẹp xuống max jobs=1
(
  unset JOBQ_SLOTS; export JOBQ_DIR="$T/q2"; rm -rf "$T/peak2" "$T/run2"; mkdir -p "$T/run2"
  "$HERE/jobq" max jobs=1 >/dev/null; "$HERE/jobq" budget jobs=3 >/dev/null
  for n in 1 2 3; do
    "$HERE/jobq" run -- bash -c "touch $T/run2/$n; echo \$(ls $T/run2 | wc -l) >> $T/peak2; sleep 1; rm $T/run2/$n" &
  done
  wait
  [ "$(sort -n "$T/peak2" | tail -1)" -le 1 ]
) || fail "ngân sách vượt trần max"

# 10) --cost lớn: 2 job cpu=3 không chạy cùng lúc dưới ngân sách cpu=4
(
  unset JOBQ_SLOTS; export JOBQ_DIR="$T/q3"; rm -rf "$T/peak3" "$T/run3"; mkdir -p "$T/run3"
  for n in 1 2; do
    "$HERE/jobq" run --cost cpu=3,mem=100 -- bash -c "touch $T/run3/$n; echo \$(ls $T/run3 | wc -l) >> $T/peak3; sleep 1; rm $T/run3/$n" &
  done
  wait
  [ "$(sort -n "$T/peak3" | tail -1)" -le 1 ]
) || fail "điểm nặng không được tính"

[ -z "$(find "$T/q/slots" "$T/q/queue" -mindepth 1 2>/dev/null)" ] || fail "còn rác slot/queue"
echo "PASS: jobq (hàng đợi, điểm nặng, trần max) + lint-script + stepper"
